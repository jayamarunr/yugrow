{
  "name": "yugrow-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "dev:fallback": "pnpm run --parallel --recursive dev",
    "db:generate": "pnpm --filter @database exec prisma generate",
    "db:migrate": "pnpm --filter @database exec prisma migrate dev",
    "db:push": "pnpm --filter @database exec prisma db push",
    "db:studio": "pnpm --filter @database exec prisma studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "setup": "pnpm install && pnpm db:generate && pnpm db:push",
    "qa:run": "node qa/pipeline.js",
    "qa:headed": "node qa/pipeline.js --headed",
    "qa:loop": "node qa/auto-fix-loop.js",
    "qa:dashboard": "echo Open qa/dashboard.html in browser",
    "qa:baseline": "node qa/visual-diff.js --update",
    "qa:visual": "node qa/visual-diff.js",
    "qa:clean": "make qa-clean",
    "qa:install": "pnpm --filter web add -D @playwright/test && npx playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

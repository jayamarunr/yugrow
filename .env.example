#################################
# Application
#################################

NODE_ENV=development

#################################
# Database
#################################

DATABASE_URL=postgresql://yugrow:yugrow_password@localhost:5432/yugrow
POSTGRES_USER=yugrow
POSTGRES_PASSWORD=yugrow_password
POSTGRES_DB=yugrow

#################################
# Redis
#################################

REDIS_URL=redis://localhost:6379

#################################
# RabbitMQ
#################################

RABBITMQ_URL=amqp://yugrow:yugrow_password@localhost:5672

#################################
# Storage (S3-compatible)
#################################

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=yugrow
S3_SECRET_KEY=yugrow_password
S3_BUCKET=yugrow

#################################
# Authentication (Authentik)
#################################

AUTHENTIK_URL=http://localhost:9443
OIDC_CLIENT_ID=yugrow-platform
OIDC_CLIENT_SECRET=change-me-in-production
OIDC_ISSUER=http://localhost:9443/application/o/yugrow-platform

#################################
# JWT
#################################

JWT_SECRET=change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

#################################
# AI Providers
#################################

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=
DEEPSEEK_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini

#################################
# Ports
#################################

API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
AI_GATEWAY_PORT=8000

// ─── Yugrow Prisma Schema v0.3 — Identity + Workspace + Permissions ─
// Multi-tenant, multi-workspace SaaS platform.
// Conventions: UUID PKs, soft deletes, audit fields on all major tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════
// LAYER 1 — IDENTITY (Who are you?)
// ═════════════════════════════════════════════════════════════════════

model Person {
  id          String       @id @default(uuid())
  authentikId String?      @unique
  email       String       @unique
  firstName   String?
  lastName    String?
  status      PersonStatus @default(ACTIVE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  memberships Membership[]
}

enum PersonStatus {
  ACTIVE
  INVITED
  DISABLED
}

// ═════════════════════════════════════════════════════════════════════
// LAYER 2 — WORKSPACE (Where are you working?)
// A workspace is the context in which work happens.
// Can represent: Personal, Company, Brand, NGO, Community, Event, etc.
// ═════════════════════════════════════════════════════════════════════

model Workspace {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  type      WorkspaceType   @default(PERSONAL)
  status    WorkspaceStatus @default(ACTIVE)

  // Branding
  logoUrl   String?
  domain    String?         // Custom domain
  timezone  String?         @default("UTC")
  locale    String?         @default("en")

  // Subscription
  tier      String?         @default("free")

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  memberships      Membership[]
  roles            Role[]
  featureFlags     FeatureFlag[]
  domains          Domain[]
  auditLogs        AuditLog[]
}

enum WorkspaceType {
  PERSONAL
  COMPANY
  BRAND
  NONPROFIT
  COMMUNITY
  EVENT
  EDUCATIONAL
  GOVERNMENT
}

enum WorkspaceStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

// ═════════════════════════════════════════════════════════════════════
// LAYER 3 — MEMBERSHIP (What is your relationship to this workspace?)
// ═════════════════════════════════════════════════════════════════════

model Membership {
  id           String           @id @default(uuid())
  personId     String
  workspaceId  String
  membershipType MembershipType @default(EMPLOYEE)

  person       Person           @relation(fields: [personId], references: [id])
  workspace    Workspace        @relation(fields: [workspaceId], references: [id])
  roles        Role[]           // Many-to-many via implicit relation table

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([personId, workspaceId])
  @@index([workspaceId])
  @@index([personId])
}

enum MembershipType {
  OWNER
  CO_FOUNDER
  EMPLOYEE
  CONTRACTOR
  CONSULTANT
  VENDOR
  AUDITOR
  PARTNER
  CUSTOMER
  INVESTOR
}

// ═════════════════════════════════════════════════════════════════════
// LAYER 4 — ROLE (What function do you serve?)
// ═════════════════════════════════════════════════════════════════════

model Role {
  id          String       @id @default(uuid())
  workspaceId String
  name        String
  description String?
  isSystem    Boolean      @default(false)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  capabilities Capability[]  // Many-to-many
  memberships Membership[]  // Many-to-many

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ═════════════════════════════════════════════════════════════════════
// LAYER 5 — CAPABILITIES (What can you do?)
// Named as: {product}.{resource}.{action}
// Examples: crm.contacts.create, website.publish, broadcast.send
// ═════════════════════════════════════════════════════════════════════

model Capability {
  id        String   @id @default(uuid())
  product   String   // e.g. "crm", "content", "broadcast", "checkin", "finance", "hr", "sites", "admin"
  resource  String   // e.g. "contacts", "pipeline", "invoice", "article"
  action    String   // e.g. "create", "read", "update", "delete", "approve", "publish"
  roles     Role[]   // Many-to-many via implicit relation table

  createdAt DateTime @default(now())

  @@unique([product, resource, action])
  @@index([product])
}

// ─── CAPABILITY SCOPE (ABAC) ────────────────────────────────────────
// Attribute-Based Access Control — restricts capabilities by attributes.
// Example: Marketing Manager can edit "Brand A" but not "Brand B".

model CapabilityScope {
  id           String   @id @default(uuid())
  roleId       String
  capabilityId String
  attribute    String   // e.g. "branch", "brand", "department", "region", "country"
  value        String   // e.g. "chennai", "brand-a", "engineering"

  @@index([roleId])
  @@index([capabilityId])
}

// ─── TEMPORARY CAPABILITY GRANT ─────────────────────────────────────
// For temporary permissions with expiry (e.g., covering for Finance).

model CapabilityGrant {
  id           String   @id @default(uuid())
  personId     String
  workspaceId  String
  capabilityId String
  grantedBy    String
  expiresAt    DateTime
  reason       String?

  createdAt    DateTime @default(now())

  @@index([personId, workspaceId])
}

// ═════════════════════════════════════════════════════════════════════
// AUDIT
// ═════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  personId    String?
  action      String
  resource    String
  resourceId  String?
  details     Json?    @default("{}")
  ipAddress   String?
  userAgent   String?
  actorContext Json?   @default("{}")  // { workspaceId, membershipType, role }

  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([action])
}

// ═════════════════════════════════════════════════════════════════════
// PRODUCT REGISTRATION
// ═════════════════════════════════════════════════════════════════════

model Product {
  id            String        @id @default(uuid())
  name          String
  description   String?
  version       String        @default("1.0.0")
  icon          String?                          // icon name or URL
  status        ProductStatus @default(DEVELOPMENT)
  owningEngine  String?                          // which engine owns this product
  ownerWorkspaceId String?                       // workspace that benefits from promotion
  configSchema  Json?                            // JSON Schema for product configuration

  // ── Discoverability & Promotion (foundation for future Promotion Engine) ──
  visibility    Visibility    @default(PUBLIC)   // PUBLIC, PRIVATE, HIDDEN
  discoverable  Boolean       @default(true)     // Can be found via search/discovery
  promotable    Boolean       @default(false)    // Eligible for paid promotion

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  capabilities  ProductCapability[]
  routes        ProductRoute[]
  navItems      ProductNavItem[]
  featureFlags  ProductFeatureFlag[]
  assignments   ProductPlanAssignment[]
}

enum ProductStatus {
  DEVELOPMENT
  BETA
  ACTIVE
  DEPRECATED
}

enum Visibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

model ProductCapability {
  id          String   @id @default(uuid())
  productId   String
  capability  String                            // e.g., "crm.contacts.create"
  description String?

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, capability])
  @@index([productId])
}

model ProductRoute {
  id          String   @id @default(uuid())
  productId   String
  path        String                            // e.g., "/checkin/events"
  method      String   @default("GET")          // GET, POST, PATCH, DELETE
  description String?
  authRequired Boolean  @default(true)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, path, method])
  @@index([productId])
}

model ProductNavItem {
  id               String   @id @default(uuid())
  productId        String
  label            String
  href             String
  icon             String?
  parentId         String?                      // for nested nav items
  requiredCapability String?                    // only show if user has this capability
  order            Int      @default(0)

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFeatureFlag {
  id          String   @id @default(uuid())
  productId   String
  key         String
  description String?
  defaultValue Boolean @default(false)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId])
}

model ProductPlanAssignment {
  id          String   @id @default(uuid())
  productId   String
  plan        String                            // "free", "pro", "business", "enterprise"
  enabled     Boolean  @default(true)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, plan])
  @@index([productId])
}

// ═════════════════════════════════════════════════════════════════════
// CHECKIN MVP — Venue, Event, Presence
// ═════════════════════════════════════════════════════════════════════

model Venue {
  id                String   @id @default(uuid())
  name              String
  address           String?
  latitude          Float?
  longitude         Float?
  city              String?
  state             String?
  country           String?
  createdByPersonId String
  ownerWorkspaceId  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            Event[]

  @@index([name])
  @@index([city, country])
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
}

model Event {
  id                   String      @id @default(uuid())
  name                 String
  venueId              String
  organizerWorkspaceId String
  startDate            DateTime
  endDate              DateTime
  status               EventStatus @default(DRAFT)
  visibility           Visibility  @default(PUBLIC)
  discoverable         Boolean     @default(true)
  promotable           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  venue                Venue       @relation(fields: [venueId], references: [id])
  presences            Presence[]

  @@index([venueId])
  @@index([status])
  @@index([startDate, endDate])
}

enum PresenceStatus {
  ACTIVE
  EXPIRED
}

model Presence {
  id          String         @id @default(uuid())
  personId    String
  workspaceId String
  eventId     String
  venueId     String
  startedAt   DateTime       @default(now())
  expiresAt   DateTime
  status      PresenceStatus @default(ACTIVE)

  event       Event          @relation(fields: [eventId], references: [id])

  @@index([eventId, status])
  @@index([personId, status])
  @@index([expiresAt])
}

// ═════════════════════════════════════════════════════════════════════
// FEATURE FLAGS (Per-Workspace Overrides)
// ═════════════════════════════════════════════════════════════════════

model FeatureFlag {
  id          String   @id @default(uuid())
  workspaceId String
  key         String
  enabled     Boolean  @default(false)
  description String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// ═════════════════════════════════════════════════════════════════════
// EDGE PLATFORM — Domains, Routes, SSL
// ═════════════════════════════════════════════════════════════════════

model Domain {
  id              String       @id @default(uuid())
  workspaceId     String
  name            String       @unique       // e.g., "www.company.com" or "tenant.yugrow.com"
  type            DomainType   @default(SUBDOMAIN)
  verificationStatus DomainVerification @default(PENDING)
  sslStatus       SSLStatus    @default(PENDING)

  targetProduct   String?                    // e.g., "sites", "content", "checkin"
  targetRoute     String?                    // internal route path
  environment     String?                    @default("production")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id])

  routes          Route[]
  redirects       Redirect[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@index([workspaceId])
  @@index([name])
}

enum DomainType {
  SUBDOMAIN        // tenant.yugrow.com
  CUSTOM           // www.custom.com
  WILDCARD         // *.custom.com
}

enum DomainVerification {
  PENDING
  VERIFYING
  VERIFIED
  FAILED
}

enum SSLStatus {
  PENDING
  PROVISIONING
  ACTIVE
  EXPIRING
  FAILED
}

model Route {
  id          String   @id @default(uuid())
  domainId    String
  path        String                // "/", "/blog/*", "/api/*"
  targetType  String                // "product", "engine", "external"
  targetId    String                // product or engine identifier
  priority    Int      @default(0)
  isActive    Boolean  @default(true)

  domain      Domain   @relation(fields: [domainId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domainId])
}

model Redirect {
  id          String   @id @default(uuid())
  domainId    String
  source      String                // "/old-path"
  destination String                // "/new-path"
  type        Int      @default(301) // 301 or 302
  isActive    Boolean  @default(true)

  domain      Domain   @relation(fields: [domainId], references: [id])

  createdAt   DateTime @default(now())

  @@index([domainId])
}

// ═════════════════════════════════════════════════════════════════════
// FILE STORAGE
// ═════════════════════════════════════════════════════════════════════

model File {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  mimeType    String
  size        Int
  storageKey  String   @unique           // S3 object key
  url         String?
  alt         String?
  width       Int?
  height      Int?

  uploadedBy  String                     // personId
  metadata    Json?    @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId])
}

// ═════════════════════════════════════════════════════════════════════
// RELATIONSHIP ENGINE
// ═════════════════════════════════════════════════════════════════════

model RelationshipType {
  id          String       @id @default(uuid())
  workspaceId String?
  name        String
  category    String?      // "Professional", "Personal", "Community", "Custom"
  description String?
  isSystem    Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  relationships Relationship[]

  @@unique([workspaceId, name])
}

model Relationship {
  id              String              @id @default(uuid())
  workspaceId     String
  typeId          String

  sourceEntityType  String
  sourceEntityId    String
  targetEntityType  String
  targetEntityId    String

  status          RelationshipStatus  @default(PENDING)
  strength        Float               @default(0.5)

  sourceNotes     String?
  targetNotes     String?

  contexts        RelationshipContext[]
  strengthSignals RelationshipStrengthSignal[]
  timeline        RelationshipTimeline[]

  type            RelationshipType    @relation(fields: [typeId], references: [id])

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@unique([workspaceId, sourceEntityType, sourceEntityId, targetEntityType, targetEntityId])
  @@index([workspaceId, sourceEntityType, sourceEntityId])
  @@index([workspaceId, targetEntityType, targetEntityId])
  @@index([workspaceId, status])
  @@index([workspaceId, strength])
}

enum RelationshipStatus {
  PENDING
  CONNECTED
  TRUSTED
  MUTED
  BLOCKED
  ARCHIVED
}

model RelationshipContext {
  id              String       @id @default(uuid())
  relationshipId  String
  source          String
  sourceDetail    String?
  firstMetAt      DateTime?
  tags            String[]
  notes           String?

  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  createdAt       DateTime     @default(now())

  @@index([relationshipId])
}

// Relationship strength signal — math-based scoring factors
model RelationshipStrengthSignal {
  id              String   @id @default(uuid())
  relationshipId  String
  signalType      String   // "message", "meeting", "event", "project", "recommendation", "transaction", "collaboration"
  weight          Float    // Contribution to overall strength (0.0 to 1.0)
  source          String   // Engine or product that emitted the signal
  sourceId        String?  // Reference to the source event/record
  timestamp       DateTime

  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId])
  @@index([relationshipId, signalType])
}

// Relationship timeline — chronological history of interactions
model RelationshipTimeline {
  id              String   @id @default(uuid())
  relationshipId  String
  eventType       String   // "connected", "message", "meeting", "project", "recommendation", "transaction", "note"
  title           String
  description     String?
  sourceEngine    String
  sourceId        String?  // Reference to event or record
  metadata        Json?    @default("{}")
  occurredAt      DateTime

  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  createdAt       DateTime @default(now())

  @@index([relationshipId])
  @@index([relationshipId, occurredAt])
}

model ConnectionRequest {
  id                String       @id @default(uuid())
  workspaceId       String
  senderPersonId    String
  recipientPersonId String
  message           String?
  status            ConnectionRequestStatus @default(PENDING)
  relationshipTypeId String?
  expiresAt         DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workspaceId, recipientPersonId, status])
  @@index([workspaceId, senderPersonId])
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ═════════════════════════════════════════════════════════════════════
// COMMUNICATION LITE — Conversation + Message
// ═════════════════════════════════════════════════════════════════════

model Conversation {
  id              String   @id @default(uuid())
  relationshipId  String
  contextType     String?                        // "event", "checkin", "broadcast"
  contextId       String?                        // event ID, broadcast ID, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        Message[]

  @@index([relationshipId])
}

model Message {
  id              String    @id @default(uuid())
  conversationId  String
  senderPersonId  String
  content         String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model ProfessionalIdentity {
  id              String   @id @default(uuid())
  workspaceId     String
  personId        String   @unique
  name            String
  title           String?
  company         String?
  phone           String?
  email           String?
  website         String?
  avatarUrl       String?
  bio             String?
  skills          String[]
  services        String[]
  industries      String[]
  certifications  Json?    @default("[]")
  portfolio       Json?    @default("[]")
  socialLinks     Json?    @default("{}")
  availability    String?
  trustScore      Float?
  verified        Boolean  @default(false)
  recommendations Int      @default(0)
  design          Json?    @default("{}")
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([workspaceId])
}

model BusinessCardCollection {
  id          String   @id @default(uuid())
  collectorId String
  cardId      String
  relationshipId String?

  collectedAt DateTime @default(now())

  @@unique([collectorId, cardId])
}

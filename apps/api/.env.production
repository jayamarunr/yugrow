# Production
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://yugrow:${PROD_DB_PASSWORD}@prod-db.yugrow.internal:5432/yugrow
JWT_SECRET=${PROD_JWT_SECRET}
REDIS_URL=redis://prod-redis.yugrow.internal:6379
RABBITMQ_URL=amqp://yugrow:${PROD_RABBIT_PASSWORD}@prod-rabbit.yugrow.internal:5672
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=${PROD_S3_ACCESS_KEY}
S3_SECRET_KEY=${PROD_S3_SECRET_KEY}
S3_BUCKET=yugrow-prod

# Staging
NODE_ENV=staging
PORT=4000
DATABASE_URL=postgresql://yugrow:${STAGING_DB_PASSWORD}@staging-db.yugrow.internal:5432/yugrow-staging
JWT_SECRET=${STAGING_JWT_SECRET}
REDIS_URL=redis://staging-redis.yugrow.internal:6379
RABBITMQ_URL=amqp://yugrow:${STAGING_RABBIT_PASSWORD}@staging-rabbit.yugrow.internal:5672
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=${STAGING_S3_ACCESS_KEY}
S3_SECRET_KEY=${STAGING_S3_SECRET_KEY}
S3_BUCKET=yugrow-staging
